{% extends "base.html.j2" %}
{% block content %}
{% from "_ideo.html.j2" import ideo %}
<section class="hero">
  <nav class="crumbs"><a href="{{ root }}{{ lang }}/">{{ t('world') }}</a></nav>
  <h1>{{ t('nav_spain') }}</h1>
  <p class="lede">{{ t('site_tagline') }}</p>
  <p>{{ t('site_description') }}</p>
  {%- if notice %}
  <p class="note">{{ t(notice) | safe }}</p>
  {%- endif %}
  <p class="cta">
    <a class="btn primary" href="{{ root }}{{ lang }}/{{ page('map') }}/">{{ t('nav_map') }}</a>
    <a class="btn" href="{{ root }}{{ lang }}/{{ page('method') }}/">{{ t('nav_method') }}</a>
    <a class="btn" href="{{ root }}{{ lang }}/{{ page('history') }}/">{{ t('nav_history') }}</a>
  </p>
</section>

{% if highlights %}
<section class="doc">
  <h2>{{ t('estimate_today') }}</h2>
  {% if congress %}
  {% from "_chamber.html.j2" import chamber %}
  {{ chamber('es-congreso', congress, 'ES', 176, 350, lang, 'seats',
             'Congreso de los Diputados: estimación de hoy' if lang == 'es' else "Congrés dels Diputats: estimació d'avui",
             (root ~ people_url) if people_url else '') }}
  {% if people %}
  <details class="mplist">
    <summary>{{ 'Quién ocuparía cada escaño (lista completa)' if lang == 'es' else 'Qui ocuparia cada escó (llista completa)' }}</summary>
    <p class="fine">{% if lang == 'es' %}Con la estimación de hoy y las listas proclamadas (BOE del 3/11/2026): el número
      k de cada lista ocupa el escaño k que el partido gana en la provincia. En el hemiciclo, haz clic en un diputado
      para ver su ficha.{% else %}Amb l'estimació d'avui i les llistes proclamades (BOE del 3/11/2026): el número k de cada
      llista ocupa l'escó k que el partit guanya a la província. A l'hemicicle, clica un diputat per veure'n la
      fitxa.{% endif %}</p>
    {% for g in people if g.members %}
    <h3><span class="sw" style="background:{{ g.color }}"></span>{{ g.name }} · {{ g.seats }}</h3>
    <ul class="cols">
      {% for m in g.members %}<li>{% if m.n %}{{ m.n }}{% else %}—{% endif %} <span class="fine">· {% if m.u %}<a href="{{ root }}{{ m.u.lstrip('/') }}">{{ m.pv }}</a>{% else %}{{ m.pv }}{% endif %}, {{ 'n.º' if lang == 'es' else 'núm.' }} {{ m.pos }}</span></li>
      {% endfor %}
    </ul>
    {% endfor %}
  </details>
  {% endif %}
  {% endif %}
  <table class="results">
    <thead><tr>
      <th>{{ t('party') }}</th>
      <th aria-hidden="true"></th>
      <th class="n">%</th>
      <th class="n">{{ t('seats_title') }}</th>
    </tr></thead>
    <tbody>
    {% for h in highlights %}
      <tr>
        <td><span class="sw" style="background:{{ h.color | vis }}"></span>{{ h.name }}{{ ideo(h.ideo, lang) }}</td>
        <td class="barcell" aria-hidden="true"><span class="vbar" style="width:{{ '%.1f'|format(100 * h.share / highlights[0].share) }}%;background:{{ h.color | vis }}"></span></td>
        <td class="n">{{ h.share | pct }}</td>
        <td class="n">{{ h.seats if h.seats else '·' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if seatgrid %}{% from "_seatgrid.html.j2" import seatgrid as sgrid %}
  <h3 id="repartiment">{{ 'El reparto, provincia a provincia, y la lucha por el último escaño' if lang == 'es' else "El repartiment, província a província, i la lluita per l'últim escó" }}</h3>
  {{ sgrid(seatgrid, lang, root ~ lang ~ '/' ~ page('sandbox') ~ '/') }}{% endif %}
  {% if trend %}{% from "_trend.html.j2" import trendchart %}
  <h3>{{ 'Cómo ha cambiado en el último año' if lang == 'es' else "Com ha canviat l'últim any" }}</h3>
  {{ trendchart(trend, lang, fdate) }}{% endif %}
  <p class="warn">{{ t('estimate_warning') | safe }}</p>
  <p class="note">{{ 'Posición e ideología de cada partido: ' if lang == 'es' else 'Posició i ideologia de cada partit: ' }}<a href="https://www.wikidata.org" rel="noopener">Wikidata</a> (CC0).</p>
</section>
{% endif %}

{% if forecast %}
{% set es = lang == 'es' %}
{% macro prob(x) %}{% if x < 0.01 %}&lt;1{% elif x > 0.99 %}&gt;99{% else %}{{ (x * 100) | round | int }}{% endif %}&nbsp;%{% endmacro %}
<section class="doc forecast" id="previsio">
  <h2>{{ 'Previsión con probabilidades' if es else 'Previsió amb probabilitats' }}</h2>
  <p class="lede small">{% if es %}Las encuestas fallan: hemos simulado las elecciones {{ forecast.n | thousands }} veces con el error típico de las medias de encuestas, circunscripción a circunscripción.{% else %}Les enquestes s'equivoquen: hem simulat les eleccions {{ forecast.n | thousands }} vegades amb l'error típic de les mitjanes d'enquestes, circumscripció a circumscripció.{% endif %}</p>
  <div class="facts">
    <span><b>{{ prob(forecast.blocs.right.majority) }}</b> {{ 'PP y Vox suman mayoría absoluta' if es else 'PP i Vox sumen majoria absoluta' }}</span>
    <span><b>{{ prob(forecast.blocs.left.majority) }}</b> {{ 'la suma que invistió a Sánchez en 2023 llega a 176' if es else 'la suma que va investir Sánchez el 2023 arriba a 176' }}</span>
    {% for r in forecast.parties[:2] %}<span><b>{{ prob(r.first) }}</b> {{ r.name }} {{ 'primer partido' if es else 'primer partit' }}</span>{% endfor %}
    <span><b>{{ prob(forecast.pp_alone) }}</b> {{ 'mayoría absoluta del PP solo' if es else 'majoria absoluta del PP sol' }}</span>
  </div>
  {% set nb = forecast.bars | length %}{% set bw = 560 / nb %}
  {% set x0 = forecast.bars[0].x %}{% set x1 = forecast.bars[-1].x %}
  <figure class="fchart">
    <svg viewBox="0 0 600 170" role="img" aria-label="{{ 'Escaños de PP y Vox en las simulaciones' if es else 'Escons de PP i Vox a les simulacions' }}">
      {% for b in forecast.bars %}<rect x="{{ '%.1f'|format(20 + (b.x - x0) / (x1 - x0 + 1) * 560) }}" y="{{ '%.1f'|format(130 - b.h * 110) }}" width="{{ '%.2f'|format([560 / (x1 - x0 + 1) - 0.6, 0.6]|max) }}" height="{{ '%.1f'|format(b.h * 110) }}" class="{{ 'maj' if b.maj else '' }}"><title>{{ b.x }}</title></rect>{% endfor %}
      {% set mx = 20 + (forecast.majority - x0) / (x1 - x0 + 1) * 560 %}
      {% if forecast.majority >= x0 and forecast.majority <= x1 %}<line x1="{{ '%.1f'|format(mx) }}" x2="{{ '%.1f'|format(mx) }}" y1="10" y2="134" class="ml"/><text x="{{ '%.1f'|format(mx + 4) }}" y="20">{{ 'mayoría' if es else 'majoria' }} 176</text>{% endif %}
      <line x1="20" x2="580" y1="130.5" y2="130.5" class="ax"/>
      <text x="20" y="150">{{ x0 }}</text><text x="580" y="150" text-anchor="end">{{ x1 }}</text>
      <text x="300" y="164" text-anchor="middle">{{ 'escaños de PP + Vox' if es else 'escons de PP + Vox' }}</text>
    </svg>
    <figcaption>{{ 'Cuántas simulaciones acaban con cada número de escaños de PP y Vox. A la derecha de la raya, mayoría absoluta.' if es else "Quantes simulacions acaben amb cada nombre d'escons de PP i Vox. A la dreta de la ratlla, majoria absoluta." }}</figcaption>
  </figure>
  <div class="tablewrap">
  <table class="results">
    <thead><tr><th>{{ t('party') }}</th><th class="n">{{ 'Escaños (mediana)' if es else 'Escons (mediana)' }}</th><th class="n">{{ 'Intervalo del 80 %' if es else 'Interval del 80 %' }}</th><th class="n">{{ 'Primer partido' if es else 'Primer partit' }}</th></tr></thead>
    <tbody>
    {% for r in forecast.parties %}
      <tr><td><span class="sw" style="background:{{ r.color }}"></span>{{ r.name }}</td><td class="n"><b>{{ r.median }}</b></td><td class="n">{{ r.lo }}–{{ r.hi }}</td><td class="n">{{ prob(r.first) if r.first >= 0.005 else '—' }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if forecast.by_turnout %}
  <h3>{{ 'Según la participación' if es else 'Segons la participació' }}</h3>
  <div class="tablewrap"><table class="results">
    <thead><tr><th>{{ 'Participación' if es else 'Participació' }}</th><th class="num">{{ 'Simulaciones' if es else 'Simulacions' }}</th>
      <th class="num">{{ 'PP + Vox, mayoría' if es else 'PP + Vox, majoria' }}</th><th class="num">{{ 'Bloque de la investidura, 176' if es else 'Bloc de la investidura, 176' }}</th>
      {% for r in forecast.by_turnout[0].parties %}<th class="num"><span class="sw" style="background:{{ r.color | vis }}"></span>{{ r.name }}</th>{% endfor %}</tr></thead>
    <tbody>{% for b in forecast.by_turnout %}<tr>
      <td>{% if b.lo is none %}{{ 'menos del' if es else 'menys del' }} {{ b.hi }} %{% elif b.hi is none %}{{ b.lo }} % {{ 'o más' if es else 'o més' }}{% else %}{{ b.lo }}–{{ b.hi }} %{% endif %}</td>
      <td class="num">{{ prob(b.share) }}</td><td class="num"><b>{{ prob(b.right) }}</b></td><td class="num">{{ prob(b.left) }}</td>
      {% for r in b.parties %}<td class="num">{{ r.median }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div>
  <p class="note">{% if es %}Cada simulación sortea también la participación (en 2023, el {{ forecast.turnout_ref | replace('.', ',') }} % del censo votó válidamente; desviación de {{ forecast.turnout_sd | replace('.', ',') }} puntos, la de las cuatro últimas generales) y aplica cómo se mueve cada electorado según el CIS. Con los datos de hoy, la participación cambia poco las probabilidades: la mayoría de PP y Vox depende más del error de las encuestas. Escaños: mediana. <a href="{{ root }}{{ lang }}/{{ page('sandbox') }}/">Pruébalo en el simulador</a>.{% else %}Cada simulació sorteja també la participació (el 2023 va votar vàlidament el {{ forecast.turnout_ref | replace('.', ',') }} % del cens; desviació de {{ forecast.turnout_sd | replace('.', ',') }} punts, la de les quatre últimes generals) i aplica com es mou cada electorat segons el CIS. Amb les dades d'avui, la participació canvia poc les probabilitats: la majoria de PP i Vox depèn més de l'error de les enquestes. Escons: mediana. <a href="{{ root }}{{ lang }}/{{ page('sandbox') }}/">Prova-ho al simulador</a>.{% endif %}</p>
  {% endif %}
  <p class="note">{% if es %}<b>Cómo se calcula.</b> En cada simulación: (1) cada partido recibe un error estatal respecto a la media de encuestas, de {{ forecast.sigma | replace('.', ',') }} × √(su %) puntos: es el error que tuvieron las medias de encuestas en la última elección de {{ forecast.sigma_countries }} países ({{ forecast.sigma_n }} partidos), así que ya no es una hipótesis; para los partidos que solo se presentan en una parte de España cuenta su % allí. (2) Un error común a cada comunidad autónoma ({{ forecast.regional | replace('.', ',') }}) y otro propio de cada provincia ({{ forecast.local | replace('.', ',') }}), medidos con cuánto se apartaron los resultados reales de 2016 a 2023 del reparto proporcional del voto. (3) La participación, como en la tabla de arriba. (4) La ley d'Hondt en las 52 circunscripciones. Las sumas de bloques son aritméticas, no coaliciones anunciadas. <a href="{{ root }}{{ lang }}/{{ page('pollsters') }}/">Cuánto se equivoca cada instituto</a>.{% else %}<b>Com es calcula.</b> A cada simulació: (1) cada partit rep un error estatal respecte de la mitjana d'enquestes, de {{ forecast.sigma | replace('.', ',') }} × √(el seu %) punts: és l'error que van tenir les mitjanes d'enquestes a l'última elecció de {{ forecast.sigma_countries }} països ({{ forecast.sigma_n }} partits), així que ja no és una hipòtesi; per als partits que només es presenten en una part d'Espanya compta el seu % allà. (2) Un error comú a cada comunitat autònoma ({{ forecast.regional | replace('.', ',') }}) i un altre de propi de cada província ({{ forecast.local | replace('.', ',') }}), mesurats amb quant es van apartar els resultats reals del 2016 al 2023 del repartiment proporcional del vot. (3) La participació, com a la taula de dalt. (4) La llei d'Hondt a les 52 circumscripcions. Les sumes de blocs són aritmètiques, no coalicions anunciades. <a href="{{ root }}{{ lang }}/{{ page('pollsters') }}/">Quant s'equivoca cada institut</a>.{% endif %}</p>
</section>
{% endif %}

{%- if simulator %}
{% include "_coalition.html.j2" %}
{%- endif %}

{% if leaders %}
<section class="doc">
{% include "_leaders.html.j2" %}
</section>
{% endif %}

{{ ad('territory_top') }}

<section class="doc">
  <h2>{{ t('provinces_of') }} España</h2>
  <ul class="children">
  {% for r in regions %}<li><a href="{{ r.url }}">{{ r.name }}</a></li>{% endfor %}
  </ul>
</section>
{% if subs %}
<section class="doc">
  <h2 id="subnacionals">{{ 'Elecciones autonómicas y municipales' if lang == 'es' else 'Eleccions autonòmiques i municipals' }}</h2>
  <div class="tablewrap">
  <table class="results part">
    <thead><tr>
      <th>{{ 'Elección' if lang == 'es' else 'Elecció' }}</th>
      <th>{{ 'Primero' if lang == 'es' else 'Primer' }}</th>
      <th class="n">{{ 'Encuestas' if lang == 'es' else 'Enquestes' }}</th>
      <th class="n">{{ 'Última' }}</th>
    </tr></thead>
    <tbody>
    {% for c in subs %}
    <tr>
      <td><a href="{{ root }}{{ c.urls[lang].lstrip('/') }}">{{ c.names[lang] }}</a> <span class="fine">({{ c.kind[lang] }})</span></td>
      <td>{% if c.first %}<span class="sw" style="background:{{ c.first.color }}"></span>{{ c.first.person or c.first.name }} {{ fmt(c.first.share) }} %{% else %}—{% endif %}</td>
      <td class="n">{{ c.n }}</td>
      <td class="n">{{ fdate(c.last) if c.last else '—' }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}
{% endblock %}
