{% extends "base.html.j2" %}
{% block content %}
{% set es = lang == 'es' %}
<article class="doc wide sandbox">
  <nav class="crumbs"><a href="{{ root }}{{ lang }}/">{{ t('world') }}</a> <span>›</span>
    <a href="{{ root }}{{ lang }}/{{ page('spain') }}/">{{ t('nav_spain') }}</a></nav>
{% if regional and regional.foreign %}
  <h1>{{ 'Simulador electoral' }}: {{ regional.place }}</h1>
  <p class="lede">{% if es %}Mueve el voto de cada partido y mira cómo se reparten los {{ regional.seats }} escaños de {{ regional.chamber }}.{% else %}Mou el vot de cada partit i mira com es reparteixen els {{ regional.seats }} escons de {{ regional.chamber }}.{% endif %}</p>
  <p class="note">{% if es %}<b>No es una previsión.</b> La media de encuestas está en la <a href="{{ root }}{{ regional.url.lstrip('/') }}">página de {{ regional.place }}</a>.{% else %}<b>No és una previsió.</b> La mitjana d'enquestes és a la <a href="{{ root }}{{ regional.url.lstrip('/') }}">pàgina de {{ regional.place }}</a>.{% endif %}</p>
{% elif regional %}
{% if es %}
  <h1>Simulador electoral: {{ regional.place }}</h1>
  <p class="lede">Mueve el voto de cada partido y mira cómo se reparten los {{ regional.seats }} escaños
    del {{ regional.chamber }} circunscripción por circunscripción. Después, haz correr la noche electoral.</p>
  <p class="note"><b>No es una previsión.</b> La media de encuestas y la estimación están en la
    <a href="{{ root }}{{ regional.url.lstrip('/') }}">página de {{ regional.place }}</a>.</p>
{% else %}
  <h1>Simulador electoral: {{ regional.place }}</h1>
  <p class="lede">Mou el vot de cada partit i mira com es reparteixen els {{ regional.seats }} escons
    del {{ regional.chamber }} circumscripció per circumscripció. Després, fes córrer la nit electoral.</p>
  <p class="note"><b>No és una previsió.</b> La mitjana d'enquestes i l'estimació són a la
    <a href="{{ root }}{{ regional.url.lstrip('/') }}">pàgina de {{ regional.place }}</a>.</p>
{% endif %}
{% elif es %}
  <h1>Simulador electoral del Congreso</h1>
  <p class="lede">Mueve el voto de cada partido, en toda España o comunidad por comunidad, y mira
    cómo se reparten los 350 escaños provincia por provincia. Después, haz correr la noche electoral.</p>
  <p class="note"><b>No es una previsión.</b> Es una herramienta para entender cómo el sistema convierte
    votos en escaños: lo que pase depende de lo que tú pongas. La previsión con las encuestas está en la
    <a href="{{ root }}{{ lang }}/{{ page('spain') }}/">página de España</a>.</p>
{% else %}
  <h1>Simulador electoral del Congrés</h1>
  <p class="lede">Mou el vot de cada partit, a tot Espanya o comunitat per comunitat, i mira com es
    reparteixen els 350 escons província per província. Després, fes córrer la nit electoral.</p>
  <p class="note"><b>No és una previsió.</b> És una eina per entendre com el sistema converteix vots en
    escons: el que passi depèn del que hi posis tu. La previsió amb les enquestes és a la
    <a href="{{ root }}{{ lang }}/{{ page('spain') }}/">pàgina d'Espanya</a>.</p>
{% endif %}

  <div class="sb-controls">
    <fieldset class="sb-base"><legend>{{ 'Punto de partida' if es else 'Punt de partida' }}</legend>
      <label><input type="radio" name="sb-base" value="now" checked> {{ 'La media de encuestas de hoy' if es else "La mitjana d'enquestes d'avui" }}</label>
      <label><input type="radio" name="sb-base" value="real"> {{ ('Resultado de ' if es else 'Resultat del ') ~ (regional.year if regional else '2023') }}</label>
      <label><input type="radio" name="sb-base" value="y2019n"> {{ 'Noviembre de 2019' if es else 'Novembre del 2019' }}</label>
      <label><input type="radio" name="sb-base" value="y2019a"> {{ 'Abril de 2019' if es else 'Abril del 2019' }}</label>
      <label><input type="radio" name="sb-base" value="y2016"> 2016</label>
    </fieldset>
    <label class="sb-where">{{ 'Dónde cambias el voto' if es else 'On canvies el vot' }}
      <select id="sb-where"></select></label>
    <div class="sb-buttons">
      <button type="button" id="sb-night"></button>
      <button type="button" id="sb-reset">{{ 'Volver al punto de partida' if es else 'Torna al punt de partida' }}</button>
      <button type="button" id="sb-share">{{ 'Copiar el enlace de este escenario' if es else "Copia l'enllaç d'aquest escenari" }}</button>
      <span id="sb-count" aria-live="polite"></span>
    </div>
  </div>

  <div class="sb-grid">
    <div id="sb-sliders" class="sb-sliders"></div>
    <div class="sb-out">
      <svg id="sb-hemi" viewBox="0 0 400 210" role="img" aria-label="{{ 'Hemiciclo' if es else 'Hemicicle' }}"></svg>
      <p id="sb-blocs" class="facts"></p>
      <div class="tablewrap">
      <table id="sb-table" class="results">
        <thead><tr><th>{{ 'Partido' if es else 'Partit' }}</th><th class="num">{{ 'Voto' if es else 'Vot' }}</th>
          <th class="num">{{ 'Escaños' if es else 'Escons' }}</th><th class="num">{{ 'Cambio' if es else 'Canvi' }}</th></tr></thead>
        <tbody></tbody>
      </table>
      </div>
    </div>
  </div>
  <section class="sb-altbox">
    <h2>{{ 'El mismo voto con otro sistema' if es else 'El mateix vot amb un altre sistema' }}</h2>
    <p>{% if es %}La ley electoral decide tanto como el voto. Con el escenario que tienes ahora, así quedarían los escaños con otras reglas.
      Entre paréntesis, la diferencia con la ley actual. <b>Gallagher</b> mide la desproporción entre votos y escaños: 0 es perfectamente
      proporcional; cuanto más alto, más premia el sistema a los grandes o a los concentrados.{% else %}La llei electoral decideix tant com el vot.
      Amb l'escenari que tens ara, així quedarien els escons amb altres regles. Entre parèntesis, la diferència amb la llei actual.
      <b>Gallagher</b> mesura la desproporció entre vots i escons: 0 és perfectament proporcional; com més alt, més premia el sistema els
      grans o els concentrats.{% endif %}</p>
    <div class="tablewrap"><table id="sb-alt" class="results"><thead></thead><tbody></tbody></table></div>
  </section>
  <div id="sb-mapwrap" class="sb-mapwrap">
    <svg id="sb-map" viewBox="0 0 900 640" role="img" aria-label="{{ 'Mapa de provincias' if es else 'Mapa de províncies' }}"><g></g></svg>
    <aside id="sb-prov" class="sb-prov" aria-live="polite" hidden></aside>
  </div>
  {% if not regional %}<p class="note sb-hint">{{ 'Toca una provincia del mapa o de la tabla para ver su reparto.' if es else 'Toca una província del mapa o de la taula per veure el seu repartiment.' }}</p>{% endif %}
  <details id="sb-bydist" class="sb-bydist" open>
    <summary>{% if regional %}{{ 'Escaños por circunscripción' if es else 'Escons per circumscripció' }}{% else %}{{ 'Escaños por provincia' if es else 'Escons per província' }}{% endif %}</summary>
    <div class="tablewrap"><table class="results"><thead></thead><tbody></tbody></table></div>
  </details>

{% if regional and regional.foreign %}
  <h2>{{ 'Cómo funciona' if es else 'Com funciona' }}</h2>
  <ul>
  {% if es %}
    <li>Los {{ regional.seats }} escaños se reparten en todo el país con {{ regional.method }}{% if regional.first and regional.first != 1 %} (primer divisor {{ regional.first }}){% endif %}{% if regional.thr %} y un umbral del {{ regional.thr }} %{% endif %}{% if regional.bonus == 'gr' %}, más la prima de 20 a 50 escaños para el primer partido{% endif %}.</li>
    <li>Donde la ley reparte por circunscripciones, esto es una aproximación: los partidos pequeños salen favorecidos. La página de {{ regional.place }} lo explica.</li>
    <li>El punto de partida es la media de encuestas de hoy. Si subes un partido, los demás bajan en proporción.</li>
  {% else %}
    <li>Els {{ regional.seats }} escons es reparteixen a tot el país amb {{ regional.method }}{% if regional.first and regional.first != 1 %} (primer divisor {{ regional.first }}){% endif %}{% if regional.thr %} i un llindar del {{ regional.thr }} %{% endif %}{% if regional.bonus == 'gr' %}, més la prima de 20 a 50 escons per al primer partit{% endif %}.</li>
    <li>On la llei reparteix per circumscripcions, això és una aproximació: els partits petits hi surten afavorits. La pàgina de {{ regional.place }} ho explica.</li>
    <li>El punt de partida és la mitjana d'enquestes d'avui. Si puges un partit, els altres baixen en proporció.</li>
  {% endif %}
  </ul>
  <p class="note">{{ 'Fuente' if es else 'Font' }}: {{ 'media de encuestas de Polit Bureau (Wikipedia, CC BY-SA 4.0); sistema electoral: artículo de cada elección en Wikipedia.' if es else "mitjana d'enquestes de Polit Bureau (Viquipèdia, CC BY-SA 4.0); sistema electoral: article de cada elecció a la Viquipèdia." }}</p>
{% elif regional %}
  <h2>{{ 'Cómo funciona' if es else 'Com funciona' }}</h2>
  <ul>
  {% if es %}
    <li>Cada circunscripción reparte sus escaños con la ley d'Hondt y el umbral de la ley autonómica.</li>
    <li>El punto de partida es el resultado real de {{ regional.year }} en cada circunscripción (Wikipedia) o ese mismo resultado movido hasta la media de encuestas de hoy.</li>
    <li>Si cambias el voto de un partido, cada circunscripción lo cambia en la misma proporción; los partidos sin barra se ajustan para que cada una sume 100.</li>
  {% else %}
    <li>Cada circumscripció reparteix els seus escons amb la llei d'Hondt i el llindar de la llei autonòmica.</li>
    <li>El punt de partida és el resultat real del {{ regional.year }} a cada circumscripció (Viquipèdia) o aquest mateix resultat mogut fins a la mitjana d'enquestes d'avui.</li>
    <li>Si canvies el vot d'un partit, cada circumscripció el canvia en la mateixa proporció; els partits sense barra s'ajusten perquè cadascuna sumi 100.</li>
  {% endif %}
  </ul>
  <p class="note">{{ 'Fuentes' if es else 'Fonts' }}: Wikipedia (CC BY-SA 4.0), {{ 'resultados por circunscripción' if es else 'resultats per circumscripció' }}; {{ 'censo electoral del INE' if es else "cens electoral de l'INE" }}; {{ 'media de encuestas de Polit Bureau' if es else "mitjana d'enquestes de Polit Bureau" }}.</p>
{% else %}
  <h2>{{ 'Cómo funciona' if es else 'Com funciona' }}</h2>
  <ul>
  {% if es %}
    <li>Cada provincia elige sus diputados con la ley d'Hondt; un partido necesita el 3 % del voto válido de la provincia.</li>
    <li>Si cambias el voto de un partido en toda España, cada provincia lo cambia en la misma proporción (si pasa del 30 al 33 %, se multiplica por 1,1 en todas). Si lo cambias en una comunidad, solo cambian sus provincias.</li>
    <li>Los partidos sin barra («otros») se ajustan para que cada provincia sume 100.</li>
    <li>«Cambio»: escaños respecto al punto de partida. La mayoría absoluta es de 176. Con los resultados de 2016 y 2019 sin tocar nada salen exactamente los escaños reales de cada provincia.</li>
    <li>La noche electoral hace entrar las provincias por tandas, en un orden fijo, hasta completar el recuento.</li>
  {% else %}
    <li>Cada província tria els seus diputats amb la llei d'Hondt; un partit necessita el 3 % del vot vàlid de la província.</li>
    <li>Si canvies el vot d'un partit a tot Espanya, cada província el canvia en la mateixa proporció (si passa del 30 al 33 %, es multiplica per 1,1 a totes). Si el canvies en una comunitat, només canvien les seves províncies.</li>
    <li>Els partits sense barra («altres») s'ajusten perquè cada província sumi 100.</li>
    <li>«Canvi»: escons respecte del punt de partida. La majoria absoluta és de 176. Amb els resultats del 2016 i del 2019 sense tocar res surten exactament els escons reals de cada província.</li>
    <li>La nit electoral fa entrar les províncies per tandes, en un ordre fix, fins a completar el recompte.</li>
  {% endif %}
  </ul>
  <p class="note">{{ 'Fuentes' if es else 'Fonts' }}: {{ 'resultado de 2023 del Ministerio del Interior y media de encuestas de Polit Bureau; límites provinciales del INE.' if es else "resultat del 2023 del Ministeri de l'Interior i mitjana d'enquestes de Polit Bureau; límits provincials de l'INE." }}</p>
  <p>{{ 'Parlamentos autonómicos' if es else 'Parlaments autonòmics' }}:
    {% for r in regional_links %}<a href="{{ root }}{{ r.url.lstrip('/') }}">{{ r.name }}</a>{{ ', ' if not loop.last else '.' }}{% endfor %}</p>
  {% if foreign_links %}<p>{{ 'Otros países' if es else 'Altres països' }}:
    {% for r in foreign_links %}<a href="{{ root }}{{ r.url.lstrip('/') }}">{{ r.name }}</a>{{ ', ' if not loop.last else '.' }}{% endfor %}</p>{% endif %}
{% endif %}
  <script type="application/json" id="sandbox-data">{{ payload | safe }}</script>
</article>
<style>
.sandbox .sb-controls{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:end;margin:16px 0}
.sandbox fieldset{border:1px solid var(--line,#ddd);padding:6px 12px;margin:0}
.sandbox .sb-buttons{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.sandbox button{padding:6px 12px;border:1px solid var(--line,#ccc);background:transparent;color:inherit;border-radius:6px;cursor:pointer}
.sandbox .sb-grid{display:grid;grid-template-columns:minmax(260px,1fr) 2fr;gap:24px}
@media (max-width:760px){.sandbox .sb-grid{grid-template-columns:1fr}}
.sandbox .sb-row{display:grid;grid-template-columns:14px 1fr 2fr 56px;gap:8px;align-items:center;margin:6px 0}
.sandbox .sb-row input{width:100%}
.sandbox .sb-row output{text-align:right;font-variant-numeric:tabular-nums}
.sandbox #sb-hemi{width:100%;max-width:520px;display:block;margin:auto}
.sandbox #sb-map{width:100%;max-width:820px;display:block;margin:16px auto}
.sandbox #sb-map path{stroke:var(--bg,#fff);stroke-width:.8}
.sandbox #sb-map path:hover{opacity:.75}
.sandbox #sb-blocs{display:flex;flex-wrap:wrap;gap:8px 18px}
.sandbox .sb-mapwrap{position:relative}
.sandbox #sb-map path{cursor:pointer;outline:none}
.sandbox #sb-map path.on,.sandbox #sb-map path:focus{stroke:currentColor;stroke-width:2}
.sandbox .sb-prov{position:absolute;top:8px;right:8px;width:290px;max-height:92%;overflow:auto;background:var(--bg,#fff);border:1px solid var(--line,#ddd);border-radius:8px;padding:10px 12px;box-shadow:0 4px 18px rgba(0,0,0,.25)}
.sandbox .sb-prov h3{margin:0 24px 2px 0}
.sandbox .sb-prov p{margin:2px 0 8px}
.sandbox .sb-x{position:absolute;top:6px;right:8px;border:0;background:transparent;font-size:20px;line-height:1;padding:2px 6px}
@media (max-width:760px){.sandbox .sb-prov{position:static;width:auto;max-height:none;margin-top:8px}}
.sandbox .sb-bydist summary{cursor:pointer;font-weight:600;margin:8px 0}
.sandbox .sb-bydist td a{color:inherit}
</style>
{% endblock %}
{% block scripts %}<script src="{{ root }}assets/sandbox.js" defer></script>{% endblock %}
