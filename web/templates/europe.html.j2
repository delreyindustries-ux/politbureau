{% extends "base.html.j2" %}
{% block content %}
{% set es = lang == 'es' %}
<article class="doc wide">
  <h1>{{ 'Encuestas de Europa' if es else "Enquestes d'Europa" }}</h1>
  <p class="lede">{% if es %}La media de las encuestas de las próximas elecciones de
    {{ rows | length }} países europeos: quién va primero y con qué porcentaje. Pulsa un país
    para ver el detalle y todas las encuestas que entran.{% else %}La mitjana de les enquestes de
    les properes eleccions de {{ rows | length }} països europeus: qui va primer i amb quin
    percentatge. Prem un país per veure'n el detall i totes les enquestes que hi entren.{% endif %}</p>

  <div class="tablewrap">
  <table class="results part">
    <thead><tr>
      <th>{{ 'País' if es else 'País' }}</th>
      <th>{{ 'Primero' if es else 'Primer' }}</th>
      <th>{{ 'Segundo' if es else 'Segon' }}</th>
      <th class="n">{{ 'Encuestas' if es else 'Enquestes' }}</th>
      <th class="n">{{ 'Última' if es else 'Última' }}</th>
    </tr></thead>
    <tbody>
    {% for r in rows %}
    <tr>
      <td><a href="{{ root }}{{ r.url.lstrip('/') }}">{{ r.name }}</a>{% if r.presidential %} <span class="fine">({{ 'presidenciales' if es else 'presidencials' }})</span>{% endif %}</td>
      <td><span class="sw" style="background:{{ r.first.color }}"></span>{{ r.first.person or r.first.name }} {{ fmt(r.first.share) }} %</td>
      <td>{% if r.second %}<span class="sw" style="background:{{ r.second.color }}"></span>{{ r.second.person or r.second.name }} {{ fmt(r.second.share) }} %{% else %}—{% endif %}</td>
      <td class="n">{{ r.n }}</td>
      <td class="n">{{ fdate(r.last) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

{% if es %}
  <p class="note">Solo aparecen los países con encuestas de los últimos 90 días. Faltan, entre
    otros, Bélgica (sus encuestas van por regiones y no hay media nacional) y los países que
    acaban de votar y aún no tienen encuestas de las próximas elecciones. España tiene su propia
    estimación, municipio a municipio, en el <a href="{{ root }}es/mapa/">mapa</a>.</p>
{% else %}
  <p class="note">Només hi surten els països amb enquestes dels últims 90 dies. En falten, entre
    d'altres, Bèlgica (les seves enquestes van per regions i no hi ha mitjana estatal) i els
    països que acaben de votar i encara no tenen enquestes de les properes eleccions. Espanya té
    la seva pròpia estimació, municipi a municipi, al <a href="{{ root }}ca/mapa/">mapa</a>.</p>
{% endif %}
  <p class="fine">{{ 'Fuente' if es else 'Font' }}: {{ 'recopilaciones de encuestas de' if es else "recopilacions d'enquestes de" }}
    <a href="https://en.wikipedia.org/" rel="noopener" target="_blank">Wikipedia</a>, CC BY-SA 4.0.</p>
</article>
{% endblock %}
