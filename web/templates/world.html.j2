{% extends "base.html.j2" %}
{% block content %}
{% set es = lang == 'es' %}
<h1 class="sr-only">{{ site_name }} · {{ 'Encuestas electorales de todo el mundo' if es else "Enquestes electorals de tot el món" }}</h1>
  <div id="pbworld" class="worldmap full" data-empty="{{ 'Sin encuestas publicadas' if es else 'Sense enquestes publicades' }}"
       data-leg="{{ 'Legislativas' if es else 'Legislatives' }}" data-pres="{{ 'Presidenciales' if es else 'Presidencials' }}"
       data-noelection="{{ 'Sin elecciones nacionales previstas' if es else 'Sense eleccions nacionals previstes' }}"
       data-polls="{{ 'encuestas' if es else 'enquestes' }}"
       data-open="{{ 'Ver las encuestas' if es else 'Veure les enquestes' }}"
       data-click="{{ 'Pulsa para ver las encuestas' if es else 'Clica per veure les enquestes' }}"
       data-label="{{ 'Globo terráqueo con el partido que encabeza las encuestas en cada país' if es else 'Globus terraqüi amb el partit que encapçala les enquestes a cada país' }}">
    <div class="wtop">
      <a class="wbrand" href="{{ root }}{{ lang }}/"><span class="dot"></span>{{ site_name }}</a>
      <div class="wbtns">
        <button type="button" data-z="in" aria-label="{{ 'Acercar' if es else 'Apropa' }}">+</button>
        <button type="button" data-z="out" aria-label="{{ 'Alejar' if es else 'Allunya' }}">−</button>
        <button type="button" data-z="europe">Europa</button>
        <button type="button" data-z="americas">{{ 'América' if es else 'Amèrica' }}</button>
        <button type="button" data-z="asia">{{ 'Asia' if es else 'Àsia' }}</button>
        <button type="button" data-z="world">{{ 'Mundo' if es else 'Món' }}</button>
      </div>
    </div>
    <div class="wbottom">
    <div class="wlinks">
      <a href="{{ root }}{{ lang }}/{{ page('countries') }}/">{{ 'Lista de países y calendario' if es else 'Llista de països i calendari' }} →</a>
      <a class="wlang" href="{{ root }}{{ other_lang_url.lstrip('/') }}">{{ t('other_lang') }}</a>
    </div>
    </div>
    <div class="wtip" hidden></div>
    <div class="wcard" hidden></div>
    <noscript><p class="wnojs">{{ 'El globo necesita JavaScript.' if es else 'El globus necessita JavaScript.' }}
      <a href="{{ root }}{{ lang }}/{{ page('countries') }}/">{{ 'Lista de países' if es else 'Llista de països' }}</a></p></noscript>
  </div>
  <script type="application/json" id="pbworld-data">{{ mapdata | safe }}</script>
{% endblock %}
{% block scripts %}
<script src="{{ root }}assets/world.js" defer></script>
{% endblock %}
